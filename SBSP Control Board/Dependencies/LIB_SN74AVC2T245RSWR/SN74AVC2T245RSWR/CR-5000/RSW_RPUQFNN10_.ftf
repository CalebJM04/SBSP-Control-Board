                  (line
                    (vertex
                      (pt -90000 70000
                        (width 25400)
                      )
                      (pt -50367 70000
                        (width 25400)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 90000 70000
                        (width 25400)
                      )
                      (pt 49600 70000
                        (width 25400)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
