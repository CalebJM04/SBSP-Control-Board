                  (line
                    (vertex
                      (pt -90000 -70000
                        (width 25400)
                      )
                      (pt -90000 70000
                        (width 25400)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 4073)
                        (begin
                          (pt -49233 -121660
                            (width 25400)
                          )
                        )
                        (center 0 0)
                        (end
                          (pt -49233 -121660
                            (width 25400)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
